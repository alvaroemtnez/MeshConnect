<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE permissions (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
                     android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Bluetooth on pre-Android-12 (BLE scan/connect legacy permission). -->
    <uses-permission android:name="android.permission.BLUETOOTH"
                     android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
                     android:maxSdkVersion="30" />
    <!-- Location: pre-12 BLE scanning needs it, and on every version
         "Share my location" in a conversation asks for it, only when used.
         The fix comes from the platform LocationManager (GPS first). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Foreground service holding the BLE/USB/TCP radio link. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- connectedDevice's prerequisite for every link, Bluetooth or not. Android 14+ starts a
         connectedDevice service only if the app holds one of a list of permissions: a granted
         Bluetooth one, or this one merely declared (a normal permission, granted at install).
         Until 1.2.0 a TCP-only user who denied Bluetooth fell back to the dataSync type
         (reticulum-mobile-app issue #35); targeting Android 15+, dataSync is limited to six
         hours a day and may not start from BOOT_COMPLETED, so it is gone. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Android 17+: reaching a radio on the local network (the TCP transport, off by default)
         needs this runtime permission. Same "Nearby devices" group as Bluetooth, so who has
         granted Bluetooth is not asked again. Requested only when TCP is on (BlePermissions). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Start the radio service with the phone (BootReceiver; a setting). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Network: TCP transport (off by default) + map tiles — the only
         outbound-HTTP feature (SCOPE.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera for QR scanning (contact import, channel/community join). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- USB host for a USB-attached MeshCore radio. Not required so the
         app still installs on phones without USB-OTG. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
        Auto Backup disabled: the app stores the node identity seed and
        (via Room) message history; secrets live in the Android Keystore
        but backup of the DB alone is still unwanted cloud exfiltration
        of message content. Same reasoning as reticulum-mobile-app
        (its audit HIGH-1).
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshCore">

        <!-- taskAffinity="" — StrandHogg-class task-injection hardening,
             carried over from reticulum-mobile-app (its audit L6). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboard|keyboardHidden"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- meshcore:// links (contact cards, channels, radio settings) from a camera
                 app's QR scan, a browser or a message. They go through the same decoder
                 and confirmations as the in-app scanner; nothing is applied unasked. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="meshcore" />
            </intent-filter>
        </activity>

        <!-- QR scanner (CameraX + ZXing core), pinned to portrait. -->
        <activity
            android:name=".platform.QrScanActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <service
            android:name=".service.MeshCoreService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />

        <!-- Boot and app-update start. Both are system broadcasts, which reach
             a non-exported receiver. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget (Glance). -->
        <receiver
            android:name=".widget.MeshWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mesh_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.MeshWidgetCompactReceiver"
            android:exported="true"
            android:label="@string/widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mesh_widget_compact_info" />
        </receiver>

        <!-- Scoped FileProvider for the GPX export share sheet: only
             cache/exports/ is exposed, read-only, per-share grants. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
