    <string name="about_version">Versión %1$s</string>
    <string name="about_description">Mensajería LoRa cifrada sin cobertura para radios MeshCore. Sin servidores, sin cuentas, sin servicios de Google Play, sin analíticas, sin informes de fallos.</string>
    <string name="about_source">Código fuente</string>
