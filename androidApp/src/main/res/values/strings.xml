    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_description">Off-grid encrypted LoRa messaging for MeshCore radios. No servers, no accounts, no Google Play Services, no analytics, no crash reporting.</string>
    <string name="about_source">Source code</string>
    <string name="about_issues">Report a problem</string>
    <string name="about_whats_new">What\'s new</string>
    <string name="about_based_on">Based on</string>
    <string name="about_credit_mch">MeshConnect is a fork of MeshCore Hardened. Its protocol layer, engine, storage and most screens are their work.</string>
    <string name="about_credit_reticulum">Transports, foreground service and app scaffolding, by the same author</string>
    <string name="about_credit_meshcore">The mesh firmware and protocol this app speaks</string>
    <string name="about_privacy">Privacy and security</string>
    <string name="about_privacy_1">Map tiles and firmware downloads are the only internet connections, and both can be avoided.</string>
    <string name="about_privacy_2">Messages, contacts and keys live on this phone and the radio. Nothing is uploaded.</string>
    <string name="about_privacy_3">Channels are obfuscated, not secure: AES-ECB with a 2-byte MAC, and the key never changes.</string>
    <string name="about_privacy_4">Advert signatures are verified before a contact is imported.</string>
    <string name="about_privacy_5">Secrets sit in the device keystore and the message database is encrypted.</string>
    <string name="about_licences">Open-source licences</string>
    <string name="about_endorsement">MeshConnect is an independent project. It is not affiliated with or endorsed by the MeshCore project or the MeshCore Hardened author.</string>
